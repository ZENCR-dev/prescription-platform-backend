# ================================================
# 反向忽略策略配置
# ================================================
# 
# 策略说明：
# 1. 本文件阻止敏感目录上传到远端Git仓库
# 2. .ignore文件提供本地IDE访问白名单
# 3. 实现"远端安全 + 本地可用"的双重保护
#
# ================================================

# 核心开发目录 (反向忽略策略)
# ------------------------------------------------
Context-Engineering-Intro/
drafts/
.claude/
archived/

# 依赖和构建产物
# ------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量文件 (安全敏感)
# ------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.staging

# 构建输出目录
# ------------------------------------------------
dist/
build/
.next/
out/
coverage/

# IDE和编辑器配置
# ------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 操作系统生成文件
# ------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 日志文件
# ------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时数据
# ------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# 测试和覆盖率报告
# ------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# 缓存目录
# ------------------------------------------------
.npm/
.yarn/
.pnpm/
.eslintcache
*.tsbuildinfo
.parcel-cache/
.cache/

# Supabase本地开发
# ------------------------------------------------
.branches
.temp
supabase/.temp/
supabase/logs/

# 临时文件和备份
# ------------------------------------------------
*.tmp
*.bak
*.swp
*.swo
*~

# 包管理器Lock文件 (可选)
# ------------------------------------------------
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# ================================================
# 历史敏感文件 (已识别)
# ================================================
recycle/docs/supabase-migration-guide.md
prd-reverse-engineering/final-docs/READMEfrontend-revised.md
prd-reverse-engineering/final-docs/02-Development-Environment-Setup.md
