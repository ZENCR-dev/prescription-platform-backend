# ================================================
# 医疗平台后端环境变量配置模板
# ================================================
#
# 使用说明:
# 1. 复制此文件为 .env.local: cp .env.example .env.local
# 2. 填入您的实际配置值（请勿使用示例值）
# 3. 确保 .env.local 已在 .gitignore 中被忽略
# 4. 生产环境请通过 Vercel/Supabase Dashboard 配置
#
# ================================================

# ============================================
# Supabase 配置 (必需)
# ============================================

# Supabase 项目 URL
# 获取方式: Supabase Dashboard > Settings > API
# 格式: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥 (公开安全)
# 获取方式: Supabase Dashboard > Settings > API > Project API keys
# 格式: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase 服务角色密钥 (服务端使用，高度敏感)
# ⚠️ 仅在 Edge Functions 中使用，严禁在客户端暴露
# 获取方式: Supabase Dashboard > Settings > API > Project API keys
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# Stripe 支付配置 (TASK06 需要)
# ============================================

# Stripe 可发布密钥 (公开安全)
# 获取方式: Stripe Dashboard > Developers > API keys
# 格式: pk_test_... (测试) 或 pk_live_... (生产)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe 私密密钥 (高度敏感)
# ⚠️ 仅在服务端使用，严禁在客户端暴露
# 格式: sk_test_... (测试) 或 sk_live_... (生产)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook 签名密钥 (敏感)
# 获取方式: Stripe Dashboard > Developers > Webhooks > 端点详情
# 格式: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ============================================
# 数据库配置 (高级用途)
# ============================================

# PostgreSQL 直连 URL (高度敏感)
# ⚠️ 仅在特殊场景下使用，通常使用 Supabase 客户端
# 格式: postgresql://postgres:password@host:port/database
# DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# ============================================
# 应用配置
# ============================================

# 应用环境
# 值: development | staging | production
NODE_ENV=development

# 应用基础 URL
# 用于: 邮件模板、重定向、CORS 配置
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# 邮件服务配置 (TASK08 可能需要)
# ============================================

# SendGrid API 密钥 (如使用 SendGrid)
# 获取方式: SendGrid Dashboard > Settings > API Keys
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Resend API 密钥 (如使用 Resend)
# 获取方式: Resend Dashboard > API Keys
# RESEND_API_KEY=re_your_resend_api_key

# ============================================
# 地图服务配置 (可选)
# ============================================

# Mapbox 访问令牌 (如需要地图功能)
# 获取方式: Mapbox Dashboard > Access tokens
# MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token

# ============================================
# 安全配置
# ============================================

# JWT 签名密钥 (如自定义 JWT)
# ⚠️ 高度敏感，使用强随机字符串
# 生成方式: openssl rand -base64 32
# JWT_SECRET=your_jwt_secret_key_here

# 会话加密密钥 (如需要)
# 生成方式: openssl rand -base64 32
# SESSION_SECRET=your_session_secret_key_here

# ============================================
# 医疗合规配置
# ============================================

# HIPAA 合规模式 (医疗平台专用)
# 值: enabled | disabled
MEDICAL_COMPLIANCE_MODE=enabled

# 审计日志等级
# 值: minimal | standard | comprehensive
AUDIT_LOG_LEVEL=comprehensive

# 数据保留策略 (天数)
# 符合医疗数据保留要求
DATA_RETENTION_DAYS=2555  # 7年

# ============================================
# 开发工具配置
# ============================================

# 调试模式
# 值: true | false
DEBUG=false

# API 响应日志
# 值: true | false
LOG_API_RESPONSES=false

# 性能监控
# 值: true | false
ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# 部署配置
# ============================================

# Vercel 项目 URL (自动设置)
# VERCEL_URL=your-project.vercel.app

# 部署环境标识
# VERCEL_ENV=development

# ============================================
# 配置验证提醒
# ============================================
#
# 配置完成后，请验证:
# ✓ 所有必需变量已填写实际值
# ✓ .env.local 未被提交到 Git
# ✓ 生产环境变量已在部署平台配置
# ✓ 敏感信息未在代码中硬编码
#
# 医疗平台安全要求:
# ✓ 启用 MEDICAL_COMPLIANCE_MODE
# ✓ 配置适当的 AUDIT_LOG_LEVEL
# ✓ 设置合规的 DATA_RETENTION_DAYS
#
# ============================================
